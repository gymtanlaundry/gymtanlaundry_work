# Local secrets for testing GitHub Actions workflows and their scripts.
#
# Copy to .github/workflows/.env (gitignored, blocked by gitleaks) and fill in
# values:  cp .github/workflows/.env.example .github/workflows/.env && chmod 600 .github/workflows/.env
#
# Keys match the GitHub Actions secret names, so this file mirrors repo secrets.
# Where a script expects a different variable name, its README shows the mapping.
# 1Password is for storing and sharing these values, not for runtime lookup.
#
# Load into a subshell only, so values don't persist in your shell:
#   (set -a; source .github/workflows/.env; set +a; <command>)
#
# Multi-line PEM keys: wrap the whole key in double quotes, line breaks intact.
# JSON values (e.g. an Okta JWK): wrap in SINGLE quotes — the shell strips
# unquoted or double-quoted JSON's inner quotes and the value becomes invalid.
# Never set GITHUB_ACTIONS here — the dept sync uses it to gate live writes.

# --- Shared --------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- jamf-okta-department-sync.yml ---------------------------------------------
# GitHub environment "Jamf Department Sync". JAMF_URL and OKTA_DOMAIN are
# hardcoded in the workflow. Client IDs are environment variables; the rest
# secrets. The DPoP key is generated per run and needs no entry.
JAMF_DEPT_SYNC_CLIENT_ID=
JAMF_DEPT_SYNC_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=

# --- jamf_infra_deploy.yml / jamf_drift.yml (Terraform jamfpro provider) -------
TF_VAR_JAMFPRO_INSTANCE_FQDN=
TF_VAR_JAMFPRO_AUTH_METHOD=
TF_VAR_JAMFPRO_CLIENT_ID=
TF_VAR_JAMFPRO_CLIENT_SECRET=
TF_VAR_JAMFPRO_ADMIN_PASSWORD=
TF_VAR_JAMFPRO_SMTP_PASSWORD=

# --- aws_infra_deploy.yml / aws_containers_build_and_deploy.yml ----------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STATE_BUCKET=
TF_VAR_VPN_SHARED_KEY_NY=
TF_VAR_VPN_SHARED_KEY_SAS=
DD_API_KEY=
DD_SITE=
OPENAI_ADMIN_KEY=
GOOGLE_CREDENTIALS=

# --- azure_infra_deploy.yml ----------------------------------------------------
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# --- intune_backup_prod.yml ----------------------------------------------------
INTUNECD_CLIENT_ID=
INTUNECD_CLIENT_SECRET=
INTUNECD_TENANT_NAME=
